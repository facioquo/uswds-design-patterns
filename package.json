{
  "name": "uswds-design-patterns",
  "license": "CC0-1.0",
  "homepage": "https://github.com/facioquo/uswds-design-patterns",
  "repository": "https://github.com/facioquo/uswds-design-patterns",
  "bugs": "https://github.com/facioquo/uswds-design-patterns/issues",
  "author": "FaciōQuō (http://facioquo.com)",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open --live-reload",
    "start:test": "ng serve --port=4200 --live-reload=false",
    "build": "ng build --configuration=development",
    "build.prod": "ng build --configuration=production",
    "watch": "ng build --configuration=development --watch",
    "lint": "pnpm run lint:md && pnpm run lint:ts && pnpm run lint:prettier",
    "lint:fix": "pnpm run lint:md:fix && pnpm run lint:ts:fix && pnpm run lint:prettier:fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:ts": "eslint .",
    "lint:ts:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.spec.json && tsc --noEmit --project tsconfig.e2e.json",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "e2e:install": "playwright install",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "gate": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test:coverage && pnpm run e2e",
    "verify": "pnpm run gate"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@uswds/uswds": "3.14.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "jsdom": "^31.0.0",
    "jsonc-eslint-parser": "^3.3.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
